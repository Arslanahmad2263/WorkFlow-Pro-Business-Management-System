# Docker Compose overrides. Copy to `.env` and adjust for your machine.

# Secret used by Django in the backend container. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated hosts allowed to reach the API (the nginx container):
ALLOWED_HOSTS=*

# Comma-separated browser origins allowed by CORS:
CORS_ALLOWED_ORIGINS=http://localhost

# Origins trusted for POST (CSRF-aware clients, e.g. Django admin via nginx):
CSRF_TRUSTED_ORIGINS=http://localhost