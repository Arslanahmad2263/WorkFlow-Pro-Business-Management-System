# Copy this file to `.env` and adjust the values for your machine.
# When no .env file exists, the backend falls back to safe local defaults
# (SQLite, Redis on localhost, DEBUG via an explicit DEBUG env var).

# Security ---------------------------------------------------------------
# DEBUG: set "True" for local development only, "False" everywhere else.
DEBUG=False
# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated hosts allowed to serve the API.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# CORS (comma-separated browser origins) ----------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Database ----------------------------------------------------------------
# PostgreSQL (Docker):  postgres://workflow:workflow@db:5432/workflow_pro
# Keep empty for SQLite (zero-setup local development).
DATABASE_URL=

# Redis -------------------------------------------------------------------
# Keep empty to use the local Redis default (analytics caching only).
REDIS_URL=redis://localhost:6379/1

# Cache TTL (seconds) for analytics endpoints
CACHE_TTL_SECONDS=60

# JWT lifetimes -----------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7